---
interface Props {
	title: string;
}

const { title } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>{title}</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href={`${apiUrl}/assets/assets/favicon.ico`} />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href={`${apiUrl}/assets/assets/css/styles.css`} rel="stylesheet" />
    
    <!-- HTMX & Plugins -->
    <script src="https://unpkg.com/htmx.org@1.9.12" is:inline></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/client-side-templates.js" is:inline></script>
    <script src="https://unpkg.com/htmx.org@1.9.12/dist/ext/response-targets.js" is:inline></script>
    <!-- Handlebars -->
    <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js" is:inline></script>
    <!-- Alpine JS -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" is:inline></script>
    
    <style is:global>
        .gradient-custom {
            /* fallback for old browsers */
            background: #6a11cb;

            /* Chrome 10-25, Safari 5.1-6 */
            background: -webkit-linear-gradient(to right,
                rgba(106, 17, 203, 1),
                rgba(37, 117, 252, 1));

            /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
            background: linear-gradient(to right,
                rgba(106, 17, 203, 1),
                rgba(37, 117, 252, 1));
        }
    </style>
</head>
<body>
    <slot />
    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" is:inline></script>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // Register Handlebars helper for status code checking
            if (typeof Handlebars !== 'undefined') {
                Handlebars.registerHelper('is5xx', function(status) {
                    return status >= 500;
                });
                Handlebars.registerHelper('is4xx', function(status) {
                    return status >= 400 && status < 500;
                });
                Handlebars.registerHelper('is2xx', function(status) {
                    return status >= 200 && status < 300;
                });

                Handlebars.registerHelper('eq', function(arg1, arg2) {
                return arg1 === arg2;
                });

                Handlebars.registerHelper('getApiUrl', () => apiUrl);

                if (localStorage.getItem("user")) {
                    Handlebars.registerHelper('isLoggedIn', () => true);
                }
                if (localStorage.getItem("isAdmin")) {
                    Handlebars.registerHelper('isAdmin', () => true);
                }
            }

            // Check for flash response cookie
            const cookies = document.cookie.split(';');
            const responseCookie = cookies.find(c => c.trim().startsWith('response='));
            if (responseCookie) {
                const message = decodeURIComponent(responseCookie.split('=')[1]);
                console.log("Success:", message.replace(/\+/g, ' '));
                // Delete the cookie
                document.cookie = 'response=; Max-Age=-99999999; Path=/;';
            }
        });

        // Initialize Alpine components
        document.addEventListener('alpine:init', () => {
            Alpine.data('formValidation', () => ({
                errors: {},
                serverError: '',
                clearErrors() {
                    this.errors = {};
                    this.serverError = '';
                },
                handleResponse(event) {
                    if (event.detail.xhr.status === 422 || 
                        event.detail.xhr.status === 404 || 
                        event.detail.xhr.status === 401 || 
                        event.detail.xhr.status === 400) {
                        try {
                            const res = JSON.parse(event.detail.xhr.response);
                            this.errors = res.errors || {};
                            if (Object.keys(this.errors).length === 0 && res.message) {
                                this.serverError = res.message;
                            }
                        } catch(e) {}
                    } else if (event.detail.xhr.status >= 500) {
                        try {
                            const res = JSON.parse(event.detail.xhr.response);
                            this.serverError = ( res.message || 'Terjadi kesalahan pada server. Silakan coba beberapa saat lagi') + ', Code : ' + event.detail.xhr.status;
                        } catch(e) {
                            this.serverError = ( event.detail.xhr.response || 'Terjadi kesalahan pada server. Silakan coba beberapa saat lagi') + ', Code : ' + event.detail.xhr.status;
                        }
                    }
                }
            }));
        });
    </script>
    <!-- Global Handlebars Error Template -->
    <template id="response-tmpl" is:raw>
        {{#if (is2xx status)}}
            <div class="alert alert-success text-start border-success border-start border-4" style="background-color: #e5ffe5; color: #1b5e20;" role="alert">
                <strong>{{message}}</strong>
            </div>
        {{else if (is4xx status)}}
            <div class="alert alert-danger text-start border-danger border-start border-4" style="background-color: #ffe5e5; color: #b71c1c;" role="alert">
                <strong>{{message}}</strong>
                {{#if errors}}
                    <ul class="mb-0 mt-2">
                        {{#each errors}}
                            <li>{{this}}</li>
                        {{/each}}
                    </ul>
                {{/if}}
            </div>
        {{else}}
            <div class="alert bg-danger text-white text-start fw-bold shadow-lg" role="alert">
                <h5 class="mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>Critical Server Error</h5>
                <hr class="border-white opacity-50 mt-0 mb-2">
                <p class="mb-0 fw-normal">{{message}}</p>
            </div>
        {{/if}}
    </template>
</body>
</html>
