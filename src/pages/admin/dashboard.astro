---
import Layout from "../../layouts/Layout.astro";
import NavbarAdmin from "../../components/NavbarAdmin.astro";
import Footer from "../../components/Footer.astro";
import ProductsTemplate from "../../components/ProductsTemplate.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<Layout title="Admin Dashboard">
  <NavbarAdmin />

  <header class="bg-gradient-to-r from-blue-700 to-indigo-800 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center text-white">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">Dashboard S-TECH</h1>
        <p class="text-lg sm:text-xl text-indigo-100 mb-8 max-w-2xl mx-auto">Manajemen Produk</p>

        <!-- Search Form -->
        <form 
          id="search-form" 
          class="flex justify-center max-w-md mx-auto mt-4" 
          role="search"
          hx-get={`${apiUrl}/api/product`}
          hx-target="#products-container"
          hx-ext="client-side-templates"
          handlebars-template="dashboard-products-tmpl"
        >
          <input
            id="search-input"
            class="w-full px-4 py-3 rounded-l-lg border-0 focus:ring-2 focus:ring-blue-500 text-gray-900"
            type="search"
            placeholder="Cari produk..."
            aria-label="Search"
            name="search"
          />
          <button class="bg-blue-600 hover:bg-blue-700 px-6 py-3 rounded-r-lg border border-transparent text-white font-medium transition-colors flex items-center justify-center" type="submit">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </header>

  <section class="py-12 sm:py-16 bg-gray-50">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-6" id="section-title">Daftar Produk</h2>
    <div class="mb-10 text-center" id="search-stats"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        id="products-container"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
        hx-get={`${apiUrl}/api/product`}
        hx-trigger="load"
        hx-ext="client-side-templates"
        handlebars-template="dashboard-products-tmpl"
      >
        <div class="col-span-full text-center py-12" id="loading-spinner">
          <svg class="animate-spin h-8 w-8 mx-auto text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <ProductsTemplate />

  <!-- bisa sekaligus pakai hx-swap-oob serta swap biasanya yg tidak dikasi tag itu, untuk ini productsPartial -->
  <script id="dashboard-products-tmpl" type="text/x-handlebars-template" is:raw>
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-6" id="section-title" hx-swap-oob="true">
      {{#if (getSearchQuery)}}Hasil pencarian produk: {{getSearchQuery}}{{else}}Daftar Produk{{/if}}
    </h2>
    <div class="mb-10 text-center" id="search-stats" hx-swap-oob="true">
      {{#if (getSearchQuery)}}<h5 class="text-gray-500 text-lg font-medium">Total produk: {{#if data.products.length}}{{data.products.length}}{{else}}0{{/if}}</h5>{{/if}}
    </div>
    
    {{> productsPartial }}
  </script>

  <script define:vars={{ apiUrl }}>
    document.addEventListener("DOMContentLoaded", () => {
      // Register Handlebars helpers
      if (typeof Handlebars !== 'undefined') {
        Handlebars.registerHelper('getSearchQuery', () => {
          const searchInput = document.getElementById("search-input");
          return searchInput ? searchInput.value.trim() : "";
        });

        // Register ProductsTemplate as a partial
        const source = document.getElementById("products-tmpl").innerHTML;
        Handlebars.registerPartial("productsPartial", source);
      }
    });
  </script>

</Layout>
