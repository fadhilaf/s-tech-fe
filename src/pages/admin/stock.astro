---
import Layout from "../../layouts/Layout.astro";
import NavbarAdmin from "../../components/NavbarAdmin.astro";
import Footer from "../../components/Footer.astro";
import FormField from "../../components/FormField.astro";
import FormDropdown from "../../components/FormDropdown.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<Layout title="Stock Admin">
  <NavbarAdmin />

  <section class="gradient-custom pb-5" style="min-height: 100vh;">
    <div class="container py-5">
      <div class="row d-flex justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
          <h2 class="fw-bold mb-4 text-uppercase text-center text-white">
            Penerimaan Stok
          </h2>

          <div class="card shadow-sm mb-4" style="border-radius: 1rem">
            <div class="card-body">
              <h5 class="mb-4">Catat Stok Masuk</h5>
              <p class="text-muted mb-4" id="product-name-display"
                hx-trigger="load"
                hx-ext="client-side-templates"
                handlebars-template="product-name-tmpl"
              >
                Memuat produk...
              </p>
              
              <form id="stock-form"
                hx-post={`${apiUrl}/api/product/admin/receive_stock`} 
                hx-request='{"credentials": true}'
                hx-ext="response-targets, client-side-templates"
                handlebars-template="alert-tmpl"
                hx-target-4xx="#alert-container"
                hx-target-5xx="#alert-container"
                hx-on::after-request="if(event.detail.successful) this.reset();"
              >
                <!-- Product Selection (Hidden) -->
                <input type="hidden" id="product_id" name="product_id" value="" />

                <!-- Supplier Selection -->
                <FormDropdown 
                  label="Supplier" id="supplier_id" name="supplier_id" required={true}
                  hx-get={`${apiUrl}/api/product/admin/supplier`}
                  hx-trigger="load"
                  hx-ext="response-targets, client-side-templates"
                  handlebars-template="supplier-options-tmpl"
                  hx-target-4xx="this"
                  hx-target-5xx="this"
                  hx-request='{"credentials": true}'
                >
                  <option value="" disabled selected>Memuat supplier...</option>
                </FormDropdown>

                <!-- Quantity -->
                <FormField 
                  type="number" label="Kuantitas Masuk" id="quantity" name="quantity" min="1" required={true}
                />

                <!-- Price -->
                <FormField 
                  type="number" label="Total Harga Modal" id="price" name="price" min="0" required={true}
                  helpText="Total biaya yang dibayarkan ke supplier untuk stok ini."
                />

                <button type="submit" class="btn btn-primary w-100 fw-bold">Terima Stok</button>
                <a href="/admin/dashboard" id="cancel-btn" class="btn btn-outline-dark w-100 fw-bold mt-2">Kembali</a>
              </form>
              
              <div class="mt-4">
                <div id="alert-container" class="mt-4"></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script id="alert-tmpl" type="text/x-handlebars-template" is:raw>
    {{#if (is2xx status)}}
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{message}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {{else}}
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{message}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {{/if}}
  </script>

  <script id="supplier-options-tmpl" type="text/x-handlebars-template" is:raw>
    <option value="" disabled selected>Pilih Supplier</option>
    {{#if (is2xx status)}}
      <div id="error-message" hx-swap-oob="true" class="alert alert-danger d-none" role="alert"></div>
      {{#each data.suppliers}}
        <option value="{{id}}">{{name}}</option>
      {{/each}}
    {{else}}
        <div id="alert-container" hx-swap-oob="true" class="alert alert-danger" role="alert">
          Loading Supplier Error: {{message}}
        </div>
        <option value="" disabled selected>{{message}}</option>
    {{/if}}
  </script>

  <script id="product-name-tmpl" type="text/x-handlebars-template" is:raw>
    {{#if (is2xx status)}}
      Terima stok untuk: <strong>{{data.product.name}}</strong>
    {{else}}
      Error: Produk tidak ditemukan
    {{/if}}
  </script>

  <script define:vars={{ apiUrl }}>
    document.addEventListener("DOMContentLoaded", () => {

      const urlParams = new URLSearchParams(window.location.search);
      const productId = urlParams.get('id');

      if (!productId) {
        document.getElementById('product-name-display').textContent = 'Error: ID Produk tidak ditemukan';
        return;
      }

      document.getElementById('product_id').value = productId;
      document.getElementById('cancel-btn').href = `/admin/edit-product?id=${productId}`;

      const nameDisplay = document.getElementById("product-name-display");
      nameDisplay.setAttribute('hx-get', `${apiUrl}/api/product/${productId}`);
      htmx.process(nameDisplay);
    });
  </script>

  <style>
    .gradient-custom {
      background: #6a11cb;
      background: -webkit-linear-gradient(to right, rgba(106, 17, 203, 1), rgba(37, 117, 252, 1));
      background: linear-gradient(to right, rgba(106, 17, 203, 1), rgba(37, 117, 252, 1));
    }
  </style>
</Layout>
