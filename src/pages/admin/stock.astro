---
import Layout from "../../layouts/Layout.astro";
import NavbarAdmin from "../../components/NavbarAdmin.astro";
import Footer from "../../components/Footer.astro";
import FormField from "../../components/FormField.astro";
import FormDropdown from "../../components/FormDropdown.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<Layout title="Stock Admin">
  <NavbarAdmin />

  <section class="gradient-custom pb-5" style="min-height: 100vh;">
    <div class="container py-5">
      <div class="row d-flex justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
          <h2 class="fw-bold mb-4 text-uppercase text-center text-white">
            Penerimaan Stok
          </h2>

          <div class="card shadow-sm mb-4" style="border-radius: 1rem">
            <div class="card-body">
              <h5 class="mb-4">Catat Stok Masuk</h5>
              
              <form id="stock-form"
                hx-post={`${apiUrl}/api/product/admin/receive_stock`} 
                hx-request='{"credentials": true}'
                hx-ext="client-side-templates"
                handlebars-template="alert-tmpl"
                hx-target="#alert-container"
                hx-on::after-request="if(event.detail.successful) this.reset();"
              >
                <!-- Product Selection -->
                <FormDropdown 
                  label="Produk" id="product_id" name="product_id" required={true}
                >
                  <option value="" disabled selected>Memuat produk...</option>
                </FormDropdown>

                <!-- Supplier Selection -->
                <FormDropdown 
                  label="Supplier" id="supplier_id" name="supplier_id" required={true}
                >
                  <option value="" disabled selected>Memuat supplier...</option>
                </FormDropdown>

                <!-- Quantity -->
                <FormField 
                  type="number" label="Kuantitas Masuk" id="quantity" name="quantity" min="1" required={true}
                />

                <!-- Price -->
                <FormField 
                  type="number" label="Total Harga Modal" id="price" name="price" min="0" required={true}
                  helpText="Total biaya yang dibayarkan ke supplier untuk stok ini."
                />

                <button type="submit" class="btn btn-primary w-100 fw-bold">Terima Stok</button>
              </form>

              <div id="alert-container" class="mt-4"></div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script id="alert-tmpl" type="text/x-handlebars-template" is:raw>
    {{#if (is2xx status)}}
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{message}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {{else}}
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{message}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {{/if}}
  </script>

  <script define:vars={{ apiUrl }}>
    document.addEventListener("DOMContentLoaded", async () => {
      // Register Handlebars helper for the alert template
      if (!Handlebars.helpers.eq) {
        Handlebars.registerHelper('eq', function(arg1, arg2) {
          return arg1 === arg2;
        });
      }

      const productSelect = document.getElementById("product_id");
      const supplierSelect = document.getElementById("supplier_id");

      // Fetch products
      try {
        const res = await fetch(`${apiUrl}/api/product`);
        if (res.ok) {
          const result = await res.json();
          productSelect.innerHTML = '<option value="" disabled selected>Pilih Produk</option>';
          if (result && result.data && result.data.products) {
            result.data.products.forEach(product => {
              if(!product.is_service) {
                const option = document.createElement("option");
                option.value = product.id;
                option.textContent = `${product.name} (Sisa Stok: ${product.stock})`;
                productSelect.appendChild(option);
              }
            });
          }
        }
      } catch (err) {
        console.error("Gagal mengambil data produk:", err);
      }

      // Fetch suppliers
      try {
        const res = await fetch(`${apiUrl}/api/product/admin/supplier`, {
          credentials: 'include'
        });
        if (res.ok) {
          const result = await res.json();
          supplierSelect.innerHTML = '<option value="" disabled selected>Pilih Supplier</option>';
          if (result && result.data && result.data.suppliers) {
            result.data.suppliers.forEach(supplier => {
              const option = document.createElement("option");
              option.value = supplier.id;
              option.textContent = supplier.name;
              supplierSelect.appendChild(option);
            });
          }
        }
      } catch (err) {
        console.error("Gagal mengambil data supplier:", err);
      }
    });
  </script>

  <style>
    .gradient-custom {
      background: #6a11cb;
      background: -webkit-linear-gradient(to right, rgba(106, 17, 203, 1), rgba(37, 117, 252, 1));
      background: linear-gradient(to right, rgba(106, 17, 203, 1), rgba(37, 117, 252, 1));
    }
  </style>
</Layout>
