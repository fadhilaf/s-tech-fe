---
import Layout from "../../layouts/Layout.astro";
import NavbarAdmin from "../../components/NavbarAdmin.astro";
import Footer from "../../components/Footer.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<Layout title="Supplier Admin">
  <NavbarAdmin />

  <section class="gradient-custom pb-5" style="min-height: 100vh;">
    <div class="container py-5">
      <div class="row d-flex justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
          <h2 class="fw-bold mb-4 text-uppercase text-center text-white">
            Manajemen Supplier
          </h2>

          <!-- Add Supplier Form -->
          <div class="card shadow-sm mb-4" style="border-radius: 1rem">
            <div class="card-body">
              <h5 class="mb-3">Tambah Supplier Baru</h5>
              <form 
                hx-post={`${apiUrl}/api/product/admin/supplier`} 
                hx-request='{"credentials": true}'
                hx-on::after-request="if(event.detail.successful) { this.reset(); fetchSuppliers(); }"
                hx-swap="none"
                class="d-flex"
              >
                <input type="text" class="form-control me-2" name="name" placeholder="Nama Supplier" required />
                <button type="submit" class="btn btn-primary">Tambah</button>
              </form>
            </div>
          </div>

          <!-- Suppliers List -->
          <div id="suppliers-container">
            <div class="text-center mt-5">
              <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script id="suppliers-tmpl" type="text/x-handlebars-template" is:raw>
    {{#if data.suppliers.length}}
      {{#each data.suppliers}}
      <div class="card mt-2 shadow-sm" style="border-radius: 1rem">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h6 class="mb-0 fw-bold">{{name}}</h6>
            <small class="text-muted">ID: {{id}}</small>
          </div>
          <form 
            hx-delete="{{../apiUrl}}/api/product/admin/supplier/{{id}}" 
            hx-request='{"credentials": true}'
            hx-confirm="Yakin ingin menghapus supplier ini?"
            hx-on::after-request="if(event.detail.successful) { fetchSuppliers(); } else { alert('Gagal menghapus. Mungkin supplier ini masih terikat dengan riwayat stok produk.'); }"
          >
            <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
          </form>
        </div>
      </div>
      {{/each}}
    {{else}}
      <div class="card mt-3" style="border-radius: 1rem">
        <div class="card-body text-center">
          <h5 class="mb-0">Belum ada data supplier.</h5>
        </div>
      </div>
    {{/if}}
  </script>

  <script define:vars={{ apiUrl }}>
    let fetchSuppliers;

    document.addEventListener("DOMContentLoaded", () => {
      const container = document.getElementById("suppliers-container");
      const source = document.getElementById("suppliers-tmpl").innerHTML;
      const template = Handlebars.compile(source);

      const renderSuppliers = (suppliers) => {
        const html = template({ data: { suppliers: suppliers || [] }, apiUrl });
        container.innerHTML = html;
        htmx.process(container);
      };

      fetchSuppliers = async () => {
        try {
          const response = await fetch(`${apiUrl}/api/product/admin/supplier`, {
            credentials: 'include'
          });
          
          if (!response.ok) {
            if (response.status === 401 || response.status === 403) {
              window.location.href = "/admin";
              return;
            }
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          
          const result = await response.json();
          if (result && result.data && result.data.suppliers) {
            renderSuppliers(result.data.suppliers);
          } else {
            renderSuppliers([]);
          }
        } catch (error) {
          console.error("Error fetching suppliers:", error);
          container.innerHTML = `
            <div class="card mt-3" style="border-radius: 1rem">
              <div class="card-body text-center text-danger">
                <h5>Gagal mengambil data supplier.</h5>
              </div>
            </div>
          `;
        }
      };

      // Expose to window for HTMX callbacks
      window.fetchSuppliers = fetchSuppliers;
      
      fetchSuppliers();
    });
  </script>

  <style>
    .gradient-custom {
      background: #6a11cb;
      background: -webkit-linear-gradient(to right, rgba(106, 17, 203, 1), rgba(37, 117, 252, 1));
      background: linear-gradient(to right, rgba(106, 17, 203, 1), rgba(37, 117, 252, 1));
    }
  </style>
</Layout>
