---
import Layout from "../layouts/Layout.astro";
import IodineField from "../components/IodineField.astro";
import IodineForm from "../components/IodineForm.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<Layout title="Register">
  <section>
    <div class="container py-5 mt-5">
      <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
          <div class="card" style="border-radius: 1rem">
            <div class="card-body p-5 text-center">
              <div class="mb-md-5 mt-md-4 pb-2">
                <h2 class="fw-bold mb-3 text-uppercase">Daftar ke S-tech</h2>
                <a class="navbar-brand ms-2 fw-bold" href="/">
                  <div>
                    <img src={`${apiUrl}/assets/assets/img/81042.jpg`} alt="S-TECH" border="0" height="150px">
                  </div>
                </a>
                
                <!-- Alpine wrapper for form state -->
                <IodineForm formId="register-form" action={`${apiUrl}/api/user`}>

                  <IodineField name="email" type="email" placeholder="Email" id="typeEmailX" rules='["required", "email"]' />
                  <IodineField name="name" placeholder="Name" id="typeUsernameX" rules='["required"]' />
                  <IodineField name="phone" placeholder="No Telpon" id="typePhoneX" rules='["required"]' />
                  <IodineField name="address" placeholder="Address" id="typeAddressX" isTextArea={true} rules='["required"]' />
                  <IodineField name="password" type="password" placeholder="Password" id="password" rules='["required"]' />
                  <IodineField name="password_confirmation" type="password" placeholder="Password Confirmation" id="typePasswordX2" rules='["required", "matchingPassword"]' />

                  <button class="btn btn-primary btn-lg px-5 mt-3 w-100 fw-bold" type="submit">
                    Daftar
                  </button>
                </IodineForm>
              </div>
              <div>
                <p class="mb-0">
                  Sudah Punya Akun ?
                  <a href="/login" class="text-black fw-bold">Login</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
