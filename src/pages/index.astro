---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProductsTemplate from "../components/ProductsTemplate.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<Layout title="Home">
  <Navbar />

  <header class="py-5 gradient-custom">
    <div class="container px-4 px-lg-5 my-5">
      <div class="text-center text-white">
        <h1 class="display-4 fw-bolder">Selamat Datang di S-TECH</h1>
        <p class="lead fw-normal text-white-50 mb-0">
          Cari Apapun Jadi Mudah di Situs Jual Beli Terlengkap!
        </p>

        <!-- HTMX form to fetch products with search parameter -->
        <form 
          id="search-form" 
          class="d-flex mt-4" 
          role="search"
          hx-get={`${apiUrl}/api/product`}
          hx-target="#products-container"
          hx-ext="client-side-templates"
          handlebars-template="index-products-tmpl"
          hx-indicator="#loading-spinner"
        >
          <input
            id="search-input"
            class="form-control me-2"
            type="search"
            placeholder="Search"
            aria-label="Search"
            name="search"
          />
          <button class="btn border-2 border-white" type="submit"
            ><i class="bi bi-search"></i></button
          >
        </form>
      </div>
    </div>
  </header>

  <section class="py-5">
    <h2 class="text-center" id="section-title">Daftar Produk</h2>

    <div class="container px-4 px-lg-5 mt-5">
      <!-- Container for HTMX to load products into -->
      <div
        id="products-container"
        class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center"
        hx-get={`${apiUrl}/api/product`}
        hx-trigger="load"
        hx-ext="client-side-templates"
        handlebars-template="index-products-tmpl"
      >
        <div class="text-center w-100" id="loading-spinner">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <ProductsTemplate />

  <script id="index-products-tmpl" type="text/x-handlebars-template" is:raw>
    <h2 class="text-center" id="section-title" hx-swap-oob="true">
      {{#if (getSearchQuery)}}Hasil pencarian produk: {{getSearchQuery}}{{else}}Daftar Produk{{/if}}
    </h2>
    
    {{> productsPartial }}
  </script>

  <script define:vars={{ apiUrl }}>
    document.addEventListener("DOMContentLoaded", () => {
      // Register Handlebars helpers
      if (typeof Handlebars !== 'undefined') {
        Handlebars.registerHelper('getSearchQuery', () => {
          const searchInput = document.getElementById("search-input");
          return searchInput ? searchInput.value.trim() : "";
        });

        // Register ProductsTemplate as a partial
        const source = document.getElementById("products-tmpl").innerHTML;
        Handlebars.registerPartial("productsPartial", source);
      }
    });
  </script>
</Layout>
