---
import InputField from "../components/InputField.astro";
import Layout from "../layouts/Layout.astro";

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---

<Layout title="Login">
  <section>
    <div class="container py-5 mt-5">
      <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">
          <div class="card" style="border-radius: 1rem">
            <div class="card-body p-5 text-center">
              <div class="mb-md-5 mt-md-4 pb-2">
                <h2 class="fw-bold mb-3 text-uppercase">Masuk ke S-tech</h2>
                <a class="navbar-brand ms-2 fw-bold" href="/">
                  <div>
                    <img src={`${apiUrl}/assets/assets/img/81042.jpg`} alt="S-TECH" border="0" height="150px">
                  </div>
                </a>
                
                <!-- HTMX Form with response-targets & client-side-templates -->
                      <!-- delete hx-request when on same origin env like nginx or dns -->
                <form id="login-form" 
                      x-data="formValidation()"
                      @htmx:before-request.camel="clearErrors()"
                      @htmx:after-request.camel="handleResponse($event)"
                      hx-post={`${apiUrl}/api/auth/login`} 
                      hx-request='{"credentials": true}'
                      hx-swap="none"
                      hx-on::before-request="const btn = this.querySelector('#submit-btn'); btn.disabled = true; btn.innerText = 'Loading...';"
                      hx-on::after-request="const btn = this.querySelector('#submit-btn'); btn.disabled = false; btn.innerText = 'Masuk';">
                  
                  <InputField name="email" type="email" id="typeEmailX" placeholder="Email" wrapperClass="mt-4" />
                  <InputField name="password" type="password" id="typePasswordX" placeholder="Password" />

                  <!-- Global Server Error Fallback -->
                  <template x-if="serverError">
                    <div class="alert alert-danger text-start fw-bold" role="alert" x-text="serverError"></div>
                  </template>

                  <button class="btn btn-primary btn-lg px-5 mt-3" type="submit" id="submit-btn">
                    Masuk
                  </button>
                </form>
              </div>
              <div>
                <p class="mb-0">
                  Belum Punya Akun ?
                  <a href="/register" class="text-black fw-bold">Register</a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
