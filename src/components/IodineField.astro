---
interface Props {
  name: string;
  type?: 'text' | 'email' | 'password' | 'number' | 'tel';
  placeholder: string;
  id?: string;
  required?: boolean;
  isTextArea?: boolean;
  wrapperClass?: string;
  rules?: string;
}

const { 
  name, 
  type = 'text', 
  placeholder, 
  id = name, 
  required = true, 
  isTextArea = false,
  wrapperClass = 'mb-4',
  rules
} = Astro.props;
---

<div class={["relative", wrapperClass].join(" ").trim()}>
  {isTextArea ? (
    <textarea 
      id={id} 
      name={name}
      class="block rounded-t-lg px-2.5 pb-2.5 pt-5 w-full text-sm text-gray-900 bg-gray-50 border-0 border-b-2 appearance-none focus:outline-none focus:ring-0 peer" 
      placeholder=" " 
      required={required}
      data-rules={rules}
      style="height: 100px"
      x-bind:class={"errors." + name + " ? 'border-red-600 focus:border-red-600' : 'border-gray-300 focus:border-blue-600'"}
    ></textarea>
  ) : (
    <input 
      type={type} 
      id={id} 
      name={name}
      class="block rounded-t-lg px-2.5 pb-2.5 pt-5 w-full text-sm text-gray-900 bg-gray-50 border-0 border-b-2 appearance-none focus:outline-none focus:ring-0 peer" 
      placeholder=" " 
      required={required} 
      data-rules={rules}
      x-bind:class={"errors." + name + " ? 'border-red-600 focus:border-red-600' : 'border-gray-300 focus:border-blue-600'"} 
    />
  )}
  <label for={id} class="absolute text-sm duration-300 transform -translate-y-4 scale-75 top-4 z-10 origin-[0] start-2.5 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-4" x-bind:class={"errors." + name + " ? 'text-red-600 peer-focus:text-red-600' : 'text-gray-500 peer-focus:text-blue-600'"}>{placeholder}</label>
  <template x-if={"errors." + name}>
    <p class="mt-2 text-sm text-red-600 font-bold text-left" x-text={"errors." + name}></p>
  </template>
</div>
