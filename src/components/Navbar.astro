---
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8080';
---
<nav class="navbar navbar-expand-lg navbar-light bg-light" x-data="{ 
  user: null, 
  async init() { 
    // Check localStorage first for fast hydration (optional)
    const u = localStorage.getItem('user'); 
    if (u) {
      try {
        this.user = JSON.parse(u);
      } catch (e) {
        this.user = null;
      }
    }

    try {
      const response = await fetch(`${apiUrl}/api/auth/me`, { 
        credentials: 'include',
      });
      
      if (response.ok) {
        const data = await response.json();
        if (data && data.data && data.data.user) {

          this.user = data.data.user;
          localStorage.setItem('user', JSON.stringify(this.user));

        } else {
          this.user = null;
          localStorage.removeItem('user');
        }
      } else {
        this.user = null;
        localStorage.removeItem('user');
        localStorage.removeItem('isAdmin');
      }
    } catch (e) {
      console.error('Failed to fetch session', e);
      // Keep cached user if network fails? Or clear it?
      // Best to clear if we can't verify, or keep it if it's just a network issue.
      // Let's keep it if we already had it.
    } 
  }
}">
    <div class="container px-4 px-lg-5">
      <a class="navbar-brand ms-2 fw-bold" href="/">
        <img src={`${apiUrl}/assets/assets/img/81042.jpg`} alt="S-TECH" height="40px">
        S-TECH
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span
          class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4" id="navbar-nav-list">
          <li class="nav-item">
            <a class="nav-link" aria-current="page" href="/">
              Home
            </a>
          </li>
          
          <!-- Show when logged out -->
          <li class="nav-item" x-show="!user" style="display: none;">
            <a class="nav-link" aria-current="page" href="/login">Login</a>
          </li>
          <li class="nav-item" x-show="!user" style="display: none;">
            <a class="nav-link" aria-current="page" href="/register">Register</a>
          </li>

          <!-- Show when logged in -->
          <li class="nav-item" x-show="user" style="display: none;">
            <a class="nav-link" aria-current="page" href="/order">Order</a>
          </li>
          <li class="nav-item" x-show="user" style="display: none;">
            <button hx-post={`${apiUrl}/api/auth/logout`}
                    hx-request='{"credentials": true}'
                    @click="localStorage.removeItem('user'); localStorage.removeItem('isAdmin');"
                    class="nav-link bg-white border-0" 
                    aria-current="page">Logout</button>
          </li>
        </ul>
        
        <!-- User Greeting Container -->
        <div class="my-auto" x-show="user" style="display: none;">
          <p class="mb-0" x-text="`Halo, ${user ? user.name : ''}`"></p>
        </div>
      </div>
    </div>
</nav>

<script define:vars={{ apiUrl }}>
  // Ensure apiUrl is available to Alpine methods by putting it on window
  window.apiUrl = apiUrl;
</script>
